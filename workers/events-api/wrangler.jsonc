{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsnbhs-events-api",
  "main": "src/index.js",
  "compatibility_date": "2026-05-15",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://gsnbhs.pages.dev",
    "GAS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbzzp0iFCBkJmlxHuR2j8Ae8xpVPc9gzmvbqBBGNUt0Whm9QpJIrUC0dIs7ZnUjacuuS/exec",
    "NOTIFY_HUB_URL": "https://village-notify-hub.ulch0709.workers.dev/notify",
    "NOTIFY_HUB_VILLAGE_CODE": "GSNBHS",
    "COMMUNITY_INVITE_URL": "https://line.me/ti/g2/7qgTAHjPmJOMSpz5FnYxCaimZuGUazMJxRuUOA?utm_source=invitation&utm_medium=link_copy&utm_campaign=default"
  },
  // 同帳號 Worker 之間不能用公開網址互打（Cloudflare error 1042），改走內部直連。
  "services": [
    {
      "binding": "NOTIFY_HUB",
      "service": "village-notify-hub"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "9a11524bfdbb4bb789fd44f58d2e8bf1"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gsnbhs-db",
      "database_id": "3fb4a75a-7f61-480a-9ad2-dc4421519ad5",
      "migrations_dir": "migrations"
    }
  ]
}
